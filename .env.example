# ==============================================================================
# Jellyfin Music Downloader V2 - Docker Environment Configuration Template
# Copy this file to .env and customize for your environment
# ==============================================================================

# Host directory where music library is stored and downloaded files are written
MUSIC_DIR=/mnt/media/music

# Path to local server_config.json containing private Jellyfin credentials
SERVER_CONFIG=./server/server_config.json

# Jellyfin Media Server Connection
JELLYFIN_URL=http://localhost:8096
JELLYFIN_TOKEN=your_jellyfin_api_token_here

# Default Jellyfin User ID (optional, 32-character GUID)
DEFAULT_USER=

# Target Audio Bitrate (e.g. 320k, 256k, 192k)
BITRATE=320k

# Concurrent Download Worker Threads (recommended: 4-6)
DOWNLOAD_THREADS=4

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Process User & Group ID (matches host user to avoid file permission issues)
PUID=1000
PGID=1000
